{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:website": "pnpm --filter @workspace/ckbhse-website run build",
  "build:vercel": "pnpm --filter @workspace/ckbhse-website run build && pnpm --filter @workspace/admin-portal run build && pnpm --filter @workspace/staff-portal run build && node ./scripts/vercel-stage-public.mjs",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @workspace/e2e run e2e",
    "security:audit": "pnpm --filter @workspace/scripts run security-audit",
    "dr:rehearsal": "pnpm --filter @workspace/scripts run dr-rehearsal",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
