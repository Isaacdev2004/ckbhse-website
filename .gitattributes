# Normalise to LF in the repository regardless of contributor platform.
# The project is developed on Windows (Cursor) and deployed on Linux (Replit);
# without this, every file touched on Windows shows as fully rewritten.
* text=auto eol=lf

*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

pnpm-lock.yaml linguist-generated=true -diff
