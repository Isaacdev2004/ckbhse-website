# Copy to .env for local development. Never commit .env.
#
# Database: Supabase (hosted Postgres). No local Docker or PostgreSQL required.
# Dashboard: https://supabase.com/dashboard/project/woszwytfhdtouesqccmf

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://woszwytfhdtouesqccmf.supabase.co

# Database password from Supabase → Project Settings → Database.
# Required before migrations or API routes that touch the database will work.
SUPABASE_DB_PASSWORD=

# Optional: copy the pooler host from Supabase → Database → Connection pooling.
# Default below is eu-west-2; change if your project uses another region.
# SUPABASE_POOLER_HOST=aws-0-eu-west-2.pooler.supabase.com

# Optional explicit URLs (override auto-build from SUPABASE_* vars above).
# App runtime — transaction pooler (port 6543):
# DATABASE_URL=postgresql://postgres.woszwytfhdtouesqccmf:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations — direct connection (port 5432):
# DATABASE_MIGRATE_URL=postgresql://postgres:[PASSWORD]@db.woszwytfhdtouesqccmf.supabase.co:5432/postgres

# UUID of the platform operator organisation that receives public website
# contact enquiries. Required whenever the database is configured.
PLATFORM_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

# Application version surfaced by /api/v1/system/version
# APP_VERSION=0.0.0

# ---------------------------------------------------------------------------
# API server (artifacts/api-server)
# ---------------------------------------------------------------------------
# NODE_ENV=development          # development | test | production
# PORT=5000
LOG_LEVEL=debug                 # fatal | error | warn | info | debug | trace | silent

# Deployment tier, which is not the same as NODE_ENV: staging runs a production
# build against non-production data, so feature flags and log verbosity need to
# tell them apart. Defaults to NODE_ENV when unset.
# APP_ENV=development           # development | test | staging | production

# Comma-separated allowlist of browser origins. Empty means same-origin only,
# which is correct behind the website's /api dev proxy and Replit's router.
# An unlisted origin receives a 403, which looks like a server bug if forgotten.
# CORS_ORIGINS=

# Set to anything other than "false" when running behind a proxy or load
# balancer. Leave false locally: trusting a non-existent proxy lets a client
# spoof X-Forwarded-For and bypass rate limiting.
# TRUST_PROXY=false

# General request budget. Credential endpoints use a stricter limiter in code.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300

# Request bodies are rejected before buffering, so an oversized payload cannot
# exhaust memory ahead of any authorisation check.
# BODY_LIMIT=100kb

# How long graceful shutdown waits for in-flight requests before forcing exit.
# SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Cookies and sessions
# ---------------------------------------------------------------------------
# Signs session and CSRF cookies. Optional until authentication lands, but
# REQUIRED in production and validated to at least 32 characters: a short secret
# is brute-forceable offline, and a cookie signature is only as good as its key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# COOKIE_SECRET=

# Leave unset for the single-origin deployment (Document 04 section 2.4), which
# scopes cookies to the exact host. Only set this for a multi-subdomain setup.
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Frontend (artifacts/ckbhse-website)
# ---------------------------------------------------------------------------
# Canonical base URL for SEO (sitemap, Open Graph, JSON-LD). Set in Vercel for
# production builds — no trailing slash.
# SITE_URL=https://www.ckbhse.co.uk
#
# The Vite dev server defaults to port 5180. PORT is shared across processes, so
# set it per-process rather than here if you run more than one.
#
# Public base path. Replit serves artifacts under a sub-path; locally use "/".
# BASE_PATH=/
#
# Where the website's Vite dev server proxies /api requests.
# API_PROXY_TARGET=http://localhost:5000

# ---------------------------------------------------------------------------
# CRM / email (M2.2)
# ---------------------------------------------------------------------------
# CRM_SUPPORT_EMAIL=enquiries@ckbhse.co.uk
# EMAIL_FROM=noreply@ckbhse.co.uk
# EMAIL_FROM_NAME=CKBHSE
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---------------------------------------------------------------------------
# Staff portal (artifacts/staff-portal)
# ---------------------------------------------------------------------------
# Dev server defaults to port 5182 with base path /staff/
# VITE_DEV_USER_ID=00000000-0000-4000-8000-000000000010
# VITE_DEV_ORG_ID=00000000-0000-4000-8000-000000000001

# ---------------------------------------------------------------------------
# Database pool (Supabase)
# ---------------------------------------------------------------------------
# DATABASE_POOL_MAX=5
