# Copy to .env for local development. Never commit .env.
# On Replit these are supplied by the platform and this file is unused.
#
# Every variable below is optional except DATABASE_URL: the API server validates
# its environment through a Zod schema at boot (artifacts/api-server/src/config/env.ts)
# and every value has a development-safe default. Commented lines show the default.

# ---------------------------------------------------------------------------
# Database (required by @workspace/db as soon as anything imports it)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ckbhse_dev

# ---------------------------------------------------------------------------
# API server (artifacts/api-server)
# ---------------------------------------------------------------------------
# NODE_ENV=development          # development | test | production
# PORT=5000
LOG_LEVEL=debug                 # fatal | error | warn | info | debug | trace | silent

# Comma-separated allowlist of browser origins. Empty means same-origin only,
# which is correct behind the website's /api dev proxy and Replit's router.
# An unlisted origin receives a 403, which looks like a server bug if forgotten.
# CORS_ORIGINS=

# Set to anything other than "false" when running behind a proxy or load
# balancer. Leave false locally: trusting a non-existent proxy lets a client
# spoof X-Forwarded-For and bypass rate limiting.
# TRUST_PROXY=false

# General request budget. Credential endpoints use a stricter limiter in code.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300

# Request bodies are rejected before buffering, so an oversized payload cannot
# exhaust memory ahead of any authorisation check.
# BODY_LIMIT=100kb

# How long graceful shutdown waits for in-flight requests before forcing exit.
# SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Frontends (artifacts/ckbhse-website, artifacts/mockup-sandbox)
# ---------------------------------------------------------------------------
# Vite dev server ports default to 5180 (website) and 5181 (sandbox). PORT is
# shared across processes, so set it per-process rather than here if you run
# more than one.
#
# Public base path. Replit serves artifacts under a sub-path; locally use "/".
# BASE_PATH=/
#
# Where the website's Vite dev server proxies /api requests.
# API_PROXY_TARGET=http://localhost:5000
