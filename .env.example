# Copy to .env for local development. Never commit .env.
# On Replit these are supplied by the platform and this file is unused.

# ---------------------------------------------------------------------------
# Database (required by @workspace/db as soon as anything imports it)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ckbhse_dev

# ---------------------------------------------------------------------------
# API server (artifacts/api-server) — defaults to 5000 when unset
# ---------------------------------------------------------------------------
# PORT=5000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Website (artifacts/ckbhse-website)
# ---------------------------------------------------------------------------
# Vite dev server port; defaults to 5173 when unset.
# PORT is shared, so set it per-process rather than here if you run both.
#
# Public base path. Replit serves artifacts under a sub-path; locally use "/".
# BASE_PATH=/
#
# Where the Vite dev server proxies /api requests.
# API_PROXY_TARGET=http://localhost:5000
